{
    "app_key": "quest.teleop.piper",
    "name": "Quest Teleop Default Touch Bindings",
    "controller_type": "oculus_touch",
    "bindings": {
        "/actions/quest_teleop": {
            "sources": [
                {
                    "path": "/user/hand/left/input/trigger",
                    "mode": "trigger",
                    "inputs": { "pull": { "output": "/actions/quest_teleop/in/Trigger" } }
                },
                {
                    "path": "/user/hand/right/input/trigger",
                    "mode": "trigger",
                    "inputs": { "pull": { "output": "/actions/quest_teleop/in/Trigger" } }
                },
                {
                    "path": "/user/hand/left/input/grip",
                    "mode": "trigger",
                    "inputs": { "pull": { "output": "/actions/quest_teleop/in/Grip" } }
                },
                {
                    "path": "/user/hand/right/input/grip",
                    "mode": "trigger",
                    "inputs": { "pull": { "output": "/actions/quest_teleop/in/Grip" } }
                },
                {
                    "path": "/user/hand/left/input/x",
                    "mode": "button",
                    "inputs": { "click": { "output": "/actions/quest_teleop/in/ButtonPrimary" } }
                },
                {
                    "path": "/user/hand/right/input/a",
                    "mode": "button",
                    "inputs": { "click": { "output": "/actions/quest_teleop/in/ButtonPrimary" } }
                },
                {
                    "path": "/user/hand/left/input/y",
                    "mode": "button",
                    "inputs": { "click": { "output": "/actions/quest_teleop/in/ButtonSecondary" } }
                },
                {
                    "path": "/user/hand/right/input/b",
                    "mode": "button",
                    "inputs": { "click": { "output": "/actions/quest_teleop/in/ButtonSecondary" } }
                },
                {
                    "path": "/user/hand/left/input/joystick",
                    "mode": "button",
                    "inputs": { "click": { "output": "/actions/quest_teleop/in/StickClick" } }
                },
                {
                    "path": "/user/hand/right/input/joystick",
                    "mode": "button",
                    "inputs": { "click": { "output": "/actions/quest_teleop/in/StickClick" } }
                }
            ]
        }
    }
}
