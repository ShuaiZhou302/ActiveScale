# Local roots. Keep machine-specific paths out of Git.
export ACTIVESCALE_DATA_ROOT=/path/to/activescale_data
export ACTIVESCALE_CACHE_ROOT=/path/to/activescale_cache
export ACTIVESCALE_ASSETS_ROOT=/path/to/activescale_assets
export ACTIVESCALE_OUTPUT_ROOT=/path/to/activescale_outputs

# PyTorch pi0.5 base checkpoint converted from the official openpi checkpoint.
export ACTIVESCALE_BASE_CHECKPOINT=/path/to/pi05_base_pytorch
export ACTIVESCALE_MIDTRAIN_CHECKPOINT=/path/to/activescale_midtrain

# Human model-ready packs and optional selection manifest.
export ACTIVESCALE_HUMAN_PACKS="$ACTIVESCALE_DATA_ROOT/human/**/*.parquet"
export ACTIVESCALE_HUMAN_SOURCE_NORM_STATS="EgoLive=$ACTIVESCALE_ASSETS_ROOT/norm/human/EgoLive.json,"\
"EgoVerse=$ACTIVESCALE_ASSETS_ROOT/norm/human/EgoVerse.json,"\
"EgoProStandard=$ACTIVESCALE_ASSETS_ROOT/norm/human/EgoProStandard.json"
export ACTIVESCALE_HUMAN_SOURCE_VIEWS="EgoLive=high_level:1+low_level:1,"\
"EgoVerse=low_level,EgoProStandard=high_level:1+low_level:1"
export ACTIVESCALE_HUMAN_SELECTION="$ACTIVESCALE_ASSETS_ROOT/manifests/human.jsonl"
export ACTIVESCALE_FAST_TOKENIZER=physical-intelligence/fast

# Local Piper data. Multiple entries are comma separated.
export ACTIVESCALE_PIPER_ROOTS="$ACTIVESCALE_DATA_ROOT/robot/piper"
export ACTIVESCALE_PIPER_CACHES="$ACTIVESCALE_CACHE_ROOT/piper"
# Use semicolons between roots and commas/ranges inside each root.
export ACTIVESCALE_PIPER_TASK_INDICES="0-34"
# Keep one comma-separated slot per root; use "-" when no allowlist applies.
export ACTIVESCALE_PIPER_INCLUDED_EPISODES="-"
# JSON with one [episode_index, frame_index] list per root. Leave unset for none.
# export ACTIVESCALE_PIPER_EXCLUDED_ANCHORS='[[[66,545]]]'
export ACTIVESCALE_PIPER_NORM_STATS="$ACTIVESCALE_ASSETS_ROOT/norm/piper.json"
export ACTIVESCALE_PIPER_REPO_ID=piper
export ACTIVESCALE_PIPER_CACHE="$ACTIVESCALE_CACHE_ROOT/piper"
export HF_LEROBOT_HOME="$ACTIVESCALE_DATA_ROOT/robot"

# Public robot sources. Use "-" when a source manifest contains absolute paths.
export ACTIVESCALE_PUBLIC_ROBOT_SOURCES=AgiBotWorld2026
export ACTIVESCALE_PUBLIC_ROBOT_MANIFESTS="$ACTIVESCALE_ASSETS_ROOT/manifests/agibotworld2026.jsonl"
export ACTIVESCALE_PUBLIC_ROBOT_ROOTS=-
export ACTIVESCALE_PUBLIC_ROBOT_CACHES="$ACTIVESCALE_CACHE_ROOT/agibotworld2026"
export ACTIVESCALE_PUBLIC_ROBOT_NORM_DIR="$ACTIVESCALE_ASSETS_ROOT/norm/public_robot"

# Frame cache used by human packs.
export USE_FRAME_CACHE=1
export FRAME_CACHE_DIR="$ACTIVESCALE_CACHE_ROOT/human"
